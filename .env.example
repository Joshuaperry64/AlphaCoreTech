# ==============================================================================
# ALPHACORE TECH // UNIFIED ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and provide your secrets.
# Identical format used across Local Development, Netlify, and Modal Backend
# ==============================================================================

# Supabase Cloud Database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# Master AI Core
GEMINI_API_KEY=your_gemini_api_key

# Stripe Payment Infrastructure
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key

# Model Repositories
CIVITAI_API_KEY=your_civitai_api_key
HF_TOKEN=your_huggingface_token

# Meta / Facebook App Scraper Credentials
FB_APP_ID=your_fb_app_id
FB_APP_SECRET=your_fb_app_secret
